SECRET_KEY=generate-a-long-random-string
# Leave empty for SQLite inside DATA_DIR. Production: postgresql+psycopg://user:pass@host:5432/automl
DATABASE_URL=
DATA_DIR=./data
MODEL_CACHE_DIR=./data/cache
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Public URL of this API, embedded into generated Colab notebooks.
# Colab cannot reach localhost. In development run a tunnel, e.g.
#   cloudflared tunnel --url http://localhost:8000
# and paste the https URL here. If unreachable, notebooks use manual upload/download mode.
PUBLIC_API_URL=http://localhost:8000

# Optional: Claude reads the user's requirement + data profile to pick task/target/metric.
# Without it, rule-based detection is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

MAX_UPLOAD_MB=2048
MAX_ACTIVE_RUNS_PER_USER=2
DEFAULT_TIME_LIMIT_PER_MODEL=300
MAX_TABULAR_ROWS=200000
MAX_CPU_IMAGES=8000
WORKER_PROCESSES=0
# true: the API process also runs training jobs (simple dev setup).
# false: run `python -m app.worker` separately (production; scale by adding workers).
RUN_WORKER_IN_API=true
